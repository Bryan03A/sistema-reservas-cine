# Copia este archivo a .env antes de ejecutar `docker compose up --build`.  NO subas .env a GitHub.
DB_PASSWORD=postgres

# Seguridad (cámbialos fuera del entorno de demostración)
JWT_ISSUER=cine-usuarios
PELICULAS_CLIENT_SECRET=peliculas-secret
RESERVAS_CLIENT_SECRET=reservas-secret
QR_SECRET=cambia-este-secreto-del-qr
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true = acepta también orígenes de tu red local (celular/laptop por Wi-Fi). Ponlo en false fuera de la demostración.
CORS_ALLOW_LAN=true
# IP de tu PC en la red local, para el certificado HTTPS (https://IP:5443). Ejemplo: EXTRA_IPS=192.168.1.15  (varias separadas por coma)
# Lo escribe automáticamente scripts/abrir-red-local.ps1 en Windows.
EXTRA_IPS=

# Reservas: segundos para confirmar antes de que expire (300 = 5 minutos). Para probar la expiración: 20
RESERVA_TTL_SECONDS=300

# Usuarios: con DEMO_MODE=true
# Comando secreto que, escrito en el campo "Usuario" del login, muestra los accesos de desarrollo (debe empezar con "/"). CÁMBIALO.
# Con DEMO_MODE=true el registro también devuelve las credenciales en pantalla (útil sin SMTP).
DEV_ACCESS_COMMAND=/dev
DEMO_MODE=true
# Correo real (por ejemplo, un buzón de pruebas de Mailtrap). Si SMTP_HOST está vacío, el correo se simula en el log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cine Andino <no-reply@cine.local>
