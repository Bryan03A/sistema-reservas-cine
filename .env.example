
# PostgreSQL / Docker
POSTGRES_USER=cine_app
POSTGRES_PASSWORD=REEMPLAZAR_CON_CLAVE_LOCAL
USUARIOS_DB=cine_usuarios
PELICULAS_DB=cine_peliculas
RESERVAS_DB=cine_reservas

# Servicio de autenticación
NODE_ENV=development
PORT=3000

# Conexión local del backend
DB_HOST=localhost
DB_PORT=5433
DB_NAME=cine_usuarios
DB_USER=cine_app
DB_PASSWORD=REEMPLAZAR_CON_CLAVE_LOCAL

# TypeORM: solo desarrollo
TYPEORM_SYNCHRONIZE=true

# JWT
JWT_ISSUER=cine-auth
JWT_AUDIENCE=cine-api
JWT_EXPIRES_IN=15m

# Contraseñas de semilla: reemplazar antes de ejecutar
SEED_ADMIN_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA
SEED_OPERATOR_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA
SEED_CLIENT1_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA
SEED_CLIENT2_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA

# Configurar Mailtrap
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=TU_USUARIO_SMTP
SMTP_PASS=TU_PASSWORD_SMTP
SMTP_FROM="Sistema de Reservas de Cine <no-reply@example.com>"

USUARIOS_API_URL=http://localhost:3000